        // ================= DEMAIS FUNÇÕES DO MASTER =================

        async function confirmarPagamentoMensal(id) {
            const dataAtual = new Date();
            const mesFormatado = prompt("Mês/Ano de referência (Ex: 08/2026):", (dataAtual.getMonth() + 1).toString().padStart(2, '0') + '/' + dataAtual.getFullYear());
            if(!mesFormatado) return;

            if(!confirm(`Confirmar recebimento do PIX para o mês ${mesFormatado}?`)) return;

            try {
                const response = await fetch(`/api/master/unidades/${id}/pagamento`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mes_ano: mesFormatado })
                });
                const data = await response.json();
                if(data.sucesso) { alert(`Pagamento confirmado!`); carregarUnidades(); } 
                else { alert("Erro: " + data.erro); }
            } catch(e) { alert('Falha de conexão.'); }
        }

        document.getElementById('form-novo-cliente').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btnSalvar = document.getElementById('btn-salvar-cliente');
            btnSalvar.innerText = 'Salvando...';

            const formData = new FormData();
            formData.append('nome_empresa', document.getElementById('input-nome-empresa').value);
            formData.append('cnpj', document.getElementById('input-cnpj').value);
            formData.append('gestor', document.getElementById('input-gestor').value);
            formData.append('telefone', document.getElementById('input-telefone').value);
            formData.append('email', document.getElementById('input-email').value);
            formData.append('endereco', document.getElementById('input-endereco').value);
            formData.append('dia_vencimento', document.getElementById('input-vencimento').value);
            formData.append('slogan', document.getElementById('input-slogan').value);
            formData.append('tema_primaria', document.getElementById('input-cor-1').value);
            formData.append('tema_secundaria', document.getElementById('input-cor-2').value);
            formData.append('senha_acesso', Math.random().toString(36).slice(-8));

            const arquivo = document.getElementById('input-logo').files[0];
            if(arquivo) formData.append('logo', arquivo);

            try {
                const response = await fetch('/api/master/unidades', { method: 'POST', body: formData });
                const data = await response.json();
                if (response.ok && data.sucesso) {
                    alert('Cliente cadastrado!');
                    this.reset();
                    document.getElementById('nome-arquivo-logo').innerText = 'Clique para anexar a Logo';
                    toggleFormulario(); carregarUnidades();
                } else { alert('Erro: ' + data.erro); }
            } catch (error) { alert('Erro de conexão.'); } 
            finally { btnSalvar.innerHTML = '<i class="ph ph-floppy-disk"></i> Salvar Registro'; }
        });

        async function alternarStatus(id, statusAtual) {
            const novo = statusAtual === 'ativa' ? 'inativa' : 'ativa';
            try {
                await fetch(`/api/master/unidades/${id}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: novo })
                });
                carregarUnidades();
            } catch(e) { alert('Falha ao alterar status.'); }
        }

        function filtrarTabela() {
            let filtro = document.getElementById('busca-lista').value.toLowerCase();
            let linhas = document.getElementById('tabela-clientes').getElementsByTagName('tr');
            for (let i = 0; i < linhas.length; i++) {
                let td = linhas[i].getElementsByTagName('td');
                if (td.length > 0) {
                    let textoLinha = td[0].textContent + " " + td[1].textContent + " " + td[2].textContent;
                    linhas[i].style.display = textoLinha.toLowerCase().indexOf(filtro) > -1 ? "" : "none";
                }
            }
        }
    </script>
